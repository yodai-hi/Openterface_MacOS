    "Applies to screenshots attached in chat and to the agentic capture_screen tool before the image is sent to the AI service.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットに添付するスクリーンショットと、エージェントの capture_screen ツールに適用され、画像を AI サービスへ送信する前にサイズが調整されます。"
          }
        }
      }
    },
    "Apply & Continue": {
